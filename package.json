{
  "name": "opencode-factory-plugin",
  "version": "0.1.1",
  "description": "OpenCode plugin for code factories",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "docs",
    "examples",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "schemas": "node --import tsx scripts/schemas.ts",
    "prepack": "npm run build && npm run schemas",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs",
    "format": "prettier --write src test scripts README.md docs package.json tsconfig.json .github",
    "format:check": "prettier --check src test scripts README.md docs package.json tsconfig.json .github"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "opencode-ai": "1.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhemerly/opencode-factory-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/lhemerly/opencode-factory-plugin/issues"
  }
}
